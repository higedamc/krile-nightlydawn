<Project Sdk="Microsoft.NET.Sdk">

  <!-- Library since leaf 1f: the executable is src/NightlyDawn.Host (composition root). This project holds the
       views and view models only and must stay free of infrastructure references (B9). -->
  <PropertyGroup>
    <AssemblyName>NightlyDawn.App</AssemblyName>
    <RootNamespace>NightlyDawn.App</RootNamespace>
    <!-- Avalonia: compiled XAML bindings by default; no icon yet (plan D3: new branding, not krile.ico). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia 12 ships Roslyn 4.14 analyzers/generators; the .NET 8 SDK (Roslyn 4.11) cannot load them (CS9057).
         Excluding analyzer assets keeps the .NET 8 toolchain; named controls are resolved with FindControl in code-behind. -->
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- Platform backends (Desktop, Wayland) and the Inter font live in NightlyDawn.Host, where AppBuilder is configured. -->
  </ItemGroup>

  <!-- Avalonia 12 ships Roslyn 4.14 analyzers/generators; the .NET 8 SDK compiler (Roslyn 4.11) refuses to load
       them (CS9057). Drop them from the compile; they only provide diagnostics and x:Name field generation, and
       this project resolves named controls with FindControl. Remove this target once the build moves to a newer SDK. -->
  <Target Name="RemoveAvaloniaRoslynAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Identity)').Contains('/avalonia/'))" />
    </ItemGroup>
  </Target>

  <!-- No reference to NightlyDawn.Nostr: the App reaches the relay layer only through Core's
       ITimelineSourceFactory / INostrBackend contracts (B9). Composition happens in src/NightlyDawn.Host.
       tests/NightlyDawn.App.Tests/ArchitectureTests.cs fails the build's test run if this changes. -->
  <ItemGroup>
    <ProjectReference Include="..\NightlyDawn.Core\NightlyDawn.Core.csproj" />
    <ProjectReference Include="..\NightlyDawn.Filters\NightlyDawn.Filters.csproj" />
    <ProjectReference Include="..\NightlyDawn.Storage\NightlyDawn.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NightlyDawn.App.Tests" />
  </ItemGroup>

</Project>
