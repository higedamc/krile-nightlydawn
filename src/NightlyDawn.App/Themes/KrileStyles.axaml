<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The few places Krile paints over Fluent's defaults. Included after FluentTheme in App.axaml, so these win.

    Why a style and not an override of whatever key Fluent's Window template reads: that key was measured to be
    neither of the obvious candidates (overriding ApplicationPageBackgroundThemeBrush left the window flat black
    in dark and flat white in light), and an internal key name is not a contract Avalonia keeps across versions.
    Setting the property we actually mean keeps the palette working when the theme's internals move.
  -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource KrileWindowBackgroundBrush}" />
  </Style>

  <!-- The timeline reads as a panel sitting on the window rather than a hole in it. Selector-based so the palette
       reaches the column without this leaf editing a single view: the shell is being rewritten in parallel (L4),
       and a colour change has no business touching those files. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource KrilePanelBackgroundBrush}" />
  </Style>

  <!-- Fluent's ListBoxItem reserves 12,9 of padding per row, which at the fork's row density (an avatar's
       48px next to two short lines) is most of a line of text per note. Selector-based for the same reason as
       the brush above: the view that owns the list is being rewritten in parallel (L4b, plan §21.2), so this
       leaf does not edit it. There is one list in the app today — the timeline — and this is deliberately
       not scoped to its x:Name, which that rewrite is free to change. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Selection is the one place the accent has to be unmistakable; Fluent's default selection is a grey wash. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KrileSelectionBrush}" />
  </Style>

  <!-- Fork parity (plan §68.8): hover/focus are a flat black wash at a fixed alpha, not a theme brush —
       the same 4%/5% overlay regardless of which palette is active (Timeline.xaml:730-774). :not(:selected)
       so a hovered or keyboard-focused selected row keeps showing the selection brush above instead of this
       wash. -->
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0A000000" />
  </Style>
  <Style Selector="ListBoxItem:focus:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0C000000" />
  </Style>

  <!-- The primary action of each panel (Subscribe, Post) carries the accent. Keyed off IsDefault rather than a
       class so no view has to be edited to opt in, and so a new panel's primary button inherits it for free. -->
  <Style Selector="Button[IsDefault=True]">
    <Setter Property="Background" Value="{DynamicResource KrileAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KrileAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource KrileOnAccentBrush}" />
  </Style>

  <!-- The fork's five button styles (StarryEyes/App.xaml:32-321) all set CornerRadius="0" explicitly; Fluent's
       default rounding on every button is the single biggest remaining gap from the fork's look (plan §68.8),
       so this corrects it globally rather than per view. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
</Styles>
