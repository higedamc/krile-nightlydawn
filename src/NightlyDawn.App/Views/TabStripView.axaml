<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="using:NightlyDawn.App.Timelines"
             x:Class="NightlyDawn.App.Views.TabStripView"
             x:DataType="tl:ColumnViewModel">
  <!-- Moved from MainWindow's header into each column (plan §21.2 / L4b): the fork nests Tabs inside Columns
       (StarryEyes MainArea.xaml ColumnTemplate:96), so the strip now belongs to the column it switches
       between, not to the window. One instance per column, inside WorkspaceView's per-column template;
       each gets its own NameScope, same as QueryBox/SubscribeButton/TimelineList already do per tab. -->
  <DockPanel>
    <Button x:Name="AddTabButton" DockPanel.Dock="Right" Content="+ Tab" Click="OnAddTabClick" />

    <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" ItemsSource="{Binding Tabs}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="tl:TimelineViewModel">
          <Border Padding="8,4" CornerRadius="4" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <!-- No persisted/user-set title yet (plan §21.2's "やらないこと": that is step 4's "クエリは
                   タブの設定へ"); shows the live query each tab was opened with, falling back before the
                   first Subscribe. -->
              <Button x:Name="TabHeaderButton" Content="{Binding ActiveTimeline.Title, FallbackValue='(new tab)'}"
                      Click="OnSelectTabClick" Tag="{Binding}" />
              <Button x:Name="CloseTabButton" Content="×" Click="OnCloseTabClick" Tag="{Binding}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- QueryBox/SubscribeButton/× for the selected tab, sharing this row instead of TimelineView's own
         docked row (plan §22.3 / L4b-2): the tab strip has ~500 DIP of unused width to the right of one tab
         header, and the query row's ~40 DIP of vertical chrome was what pushed Linux's TimelineList under
         the 600x60 floor (plan §22.2). RequestClose stays the contract CloseTab wires on AddTab; only who
         presses it moved. -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,0,0,0" DataContext="{Binding SelectedTab}">
      <TextBox x:Name="QueryBox" Grid.Column="0" MinWidth="420"
               Text="{Binding Query, Mode=TwoWay}"
               PlaceholderText="from home   |   from user(npub1...)   |   from search(&quot;nostr&quot;)" />
      <Button x:Name="SubscribeButton" Grid.Column="1" Margin="8,0,0,0" Content="Subscribe" IsDefault="True"
              Click="OnSubscribeClick" />
      <Button x:Name="CloseTabButton" Grid.Column="2" Margin="4,0,0,0" Content="×" Click="OnCloseSelectedTabClick" />
    </Grid>
  </DockPanel>
</UserControl>
