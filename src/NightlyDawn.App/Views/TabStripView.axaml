<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="using:NightlyDawn.App.Timelines"
             xmlns:core="using:NightlyDawn.Core"
             x:Class="NightlyDawn.App.Views.TabStripView"
             x:DataType="tl:ColumnViewModel">
  <!-- Moved from MainWindow's header into each column (plan §21.2 / L4b): the fork nests Tabs inside Columns
       (StarryEyes MainArea.xaml ColumnTemplate:96), so the strip now belongs to the column it switches
       between, not to the window. One instance per column, inside WorkspaceView's per-column template;
       each gets its own NameScope, same as QueryBox/SubscribeButton/TimelineList already do per tab. -->
  <DockPanel>
    <!-- Column head is tab headers + "+ Tab" + a settings toggle only (plan §26.5 / L4c ④ — the screenshot's
         column head has no query box). QueryBox/SubscribeButton/× moved again below, into TabSettingsPanel,
         collapsed by default: TabStripView.axaml.cs opens it right after AddTab (an unsubscribed new tab has
         no other way in) and SettingsToggle flips it the rest of the time. Also removes the ~40 DIP the query
         row used to cost every column all the time (plan §22.3 / L4b-2), which L4c's ②⑥ spend elsewhere. -->
    <DockPanel DockPanel.Dock="Top">
      <!-- IsEnabled follows ColumnViewModel.CanAddTab (L9-2, plan §34): the view model owns the bound
           (AppState.MaxTabsPerColumn), this only shows it; same shape as WorkspaceView's AddColumnButton. -->
      <Button x:Name="AddTabButton" DockPanel.Dock="Right" Content="+ Tab" IsEnabled="{Binding CanAddTab}" Click="OnAddTabClick" />
      <!-- IsChecked is the single source of truth for open/closed (Lead's §28 review): TabSettingsPanel.IsVisible
           binds to it below instead of a second, hand-toggled bool, so the toggle's own checked-paint and the
           panel's visibility can never disagree. ToggleButton flips IsChecked itself on a real click — no
           Click handler needed here anymore. -->
      <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" Margin="0,0,4,0" Content="⚙" />

      <!-- HorizontalAlignment="Left": DockPanel's LastChildFill ignores the last child's own Dock and gives
           it all remaining row width regardless (true before §28.6 ③ too, it just didn't show: a column's
           row was never wider than this ItemsControl's own content). Now that §28.6 ③ stretches a column to
           fill the window, an unconstrained TabStrip would report a Bounds.Width spanning that whole row's
           leftover space instead of its tab buttons' actual width — not a visual bug (items stay
           left-aligned in the extra room), but it breaks anything measuring "where the tab labels end"
           (ThemeSwitcherRenderTests compares exactly that against the header's theme switch). -->
      <ItemsControl x:Name="TabStrip" DockPanel.Dock="Left" HorizontalAlignment="Left" ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="tl:TimelineViewModel">
            <Border Padding="8,4" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- No persisted/user-set title yet (plan §21.2's "やらないこと": that is step 4's "クエリは
                     タブの設定へ"); shows the live query each tab was opened with, falling back before the
                     first Subscribe. -->
                <Button x:Name="TabHeaderButton" Content="{Binding ActiveTimeline.Title, FallbackValue='(new tab)'}"
                        Click="OnSelectTabClick" Tag="{Binding}" />
                <Button x:Name="CloseTabButton" Content="×" Click="OnCloseTabClick" Tag="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- The tab's settings: just QueryBox/SubscribeButton/× for now (plan §26.5's "タブの設定の形はRengeの裁量").
         A Popup, not an inline row (Lead's §28 review ①): QueryBox's MinWidth=420 used to sit in the column's
         own DockPanel, so opening it could force the column wider than its shared budget and overflow the
         window's 1280 DIP total (measured: 1,104 -> 1,644 DIP with all three open). A Popup renders in the
         window's overlay layer instead of the column's layout flow, so opening it can never change
         ColumnsHost's width — not "accept the overflow", the budget question doesn't arise. IsOpen mirrors
         SettingsToggle.IsChecked two-way, but Popup.IsLightDismissEnabled defaults to False and this binding
         does not turn it on (Lead's §30 review, measured by hand: clicking outside the Popup, and Escape,
         both leave IsChecked/IsOpen unchanged). The gear is the only way to close this today, which is
         consistent, not broken. Turning on light-dismiss is future work, and only after a state-machine
         test covers the close-via-light-dismiss step: ToggleButton's own IsChecked does not know a dismiss
         happened, so a naive flip risks the gear re-opening the Popup it was just dismissed from. -->
    <Popup x:Name="TabSettingsPanel" PlacementTarget="{Binding #SettingsToggle}" Placement="BottomEdgeAlignedRight"
           IsOpen="{Binding #SettingsToggle.IsChecked, Mode=TwoWay}" DataContext="{Binding SelectedTab}">
      <Border Padding="8" CornerRadius="4" BorderThickness="1" Background="{DynamicResource KrilePanelBackgroundBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <!-- MaxLength is the contract's own constant via x:Static, not a second number (L9-2, plan §34): the
               TextBox is the one place a user produces a query, and TextBox applies MaxLength to pasted text as
               well as typed, so a query the store would refuse to save (AppState.MaxQueryLength) cannot be
               entered. Without it, one over-long paste into any tab made every later save of the whole layout
               fail for the rest of the session, reported only on stderr (Lead's probes A and D). -->
          <!-- Both the short PlaceholderText and the full ToolTip.Tip must themselves be valid KQL (kql.txt's
               `from` clause is optional, but KqlParser.ParseFromClause requires it: plan §44 / L10, §48-49 /
               L10 v2). `where` is mandatory everywhere, so each example ends in `where ()` ("match
               everything"), and SOURCE's STRING argument must be quoted, so the `user(...)` example quotes a
               real npub rather than the bare `npub1...` the fork's hint used. QueryHintComplianceTests asserts
               every piece compiles, read live off these two properties rather than copied into the test, so
               this text can never drift out of sync with the grammar again.

               The three full examples live in ToolTip.Tip, not PlaceholderText (L10 v2, Lead's §48 review):
               inside the settings Popup, QueryBox's available width is unconstrained, so the `*` column grows
               to fit however long PlaceholderText's rendered ink is — at L10 v1's 146-character,
               three-example hint (not the fork's original, which is 62 characters and never grows the panel
               past master's 558 DIP) that pushed the settings panel to 1138 DIP wide, enough that at 1100 DIP
               the headless input path's coordinates no longer agree with TranslatePoint's for SubscribeButton,
               even though its centre stays inside the window (measured: 1280 DIP window had 142 DIP of margin
               left, a 10% longer hint lost it too). A ToolTip does not participate in its owner's measure pass, so
               it cannot move the panel's width; PlaceholderText now carries only the one short example that
               used to fit before L10 (MinWidth 420 unaffected). -->
          <TextBox x:Name="QueryBox" Grid.Column="0" MinWidth="420"
                   MaxLength="{x:Static core:AppState.MaxQueryLength}"
                   Text="{Binding Query, Mode=TwoWay}"
                   PlaceholderText="from home where ()"
                   ToolTip.Tip="from home where ()   |   from user(&quot;npub1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqshp52w2&quot;) where ()   |   from search(&quot;nostr&quot;) where ()" />
          <Button x:Name="SubscribeButton" Grid.Column="1" Margin="8,0,0,0" Content="Subscribe" IsDefault="True"
                  Click="OnSubscribeClick" />
          <Button x:Name="CloseSelectedTabButton" Grid.Column="2" Margin="4,0,0,0" Content="×" Click="OnCloseSelectedTabClick" />
        </Grid>
      </Border>
    </Popup>
  </DockPanel>
</UserControl>
