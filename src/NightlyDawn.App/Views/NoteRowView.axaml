<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="using:NightlyDawn.App.Timelines"
             x:Class="NightlyDawn.App.Views.NoteRowView"
             x:DataType="tl:NoteRow">
  <StackPanel Spacing="2" Margin="0,4">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="{Binding AuthorLabel}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding TimeLabel}" Opacity="0.6" />
    </StackPanel>
    <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ReplyButton" Content="Reply" FontSize="12"
              IsEnabled="{Binding CanReplyOrRepost}" Click="OnReplyClick" />
      <Button x:Name="RepostButton" Content="Repost" FontSize="12"
              IsEnabled="{Binding CanReplyOrRepost}" Click="OnRepostClick" />
      <Button x:Name="QuoteButton" Content="Quote" FontSize="12" Click="OnQuoteClick" />
      <Button x:Name="ReactButton" Content="♥" FontSize="12" Click="OnReactClick" />
    </StackPanel>
  </StackPanel>
</UserControl>
