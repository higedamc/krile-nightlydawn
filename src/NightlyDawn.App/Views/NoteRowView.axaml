<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tl="using:NightlyDawn.App.Timelines"
             xmlns:views="using:NightlyDawn.App.Views"
             x:Class="NightlyDawn.App.Views.NoteRowView"
             x:DataType="tl:NoteRow">
  <!--
    The row's shape, matched against the fork's own StarryEyes/Views/WindowParts/Primitives/Timeline.xaml
    (plan §21.1): an avatar gutter on the left, the timestamp pinned to the right edge, and the per-note
    command buttons hidden until the pointer is over the row (`CommandButtonRootPanel` there, :pointerover
    here — WPF storyboards have no Avalonia equivalent worth importing for a show/hide).

    One deliberate difference from that file, because the piece it needs has not landed yet:
      - selection does not reveal the commands, only hover. The fork keys off IsSelected as well, which lives
        on the ListBoxItem *above* this control — a UserControl's styles cannot select its own ancestor, and
        the view that owns the list is being rewritten in parallel (L4b, plan §21.2).
  -->
  <UserControl.Styles>
    <!-- Both halves of every hover swap are styles, and none of these elements carries IsVisible in its own
         attributes. That is load-bearing, not tidiness: in Avalonia a locally set property value outranks any
         style setter, so an element written as IsVisible="False" in the markup below could never be revealed
         by the :pointerover rule — it would silently stay hidden forever. The resting state has to be a
         style for the hover state to be able to win. -->
    <Style Selector="views|NoteRowView Border#CommandBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|NoteRowView TextBlock#LongTime">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Hidden, not merely transparent: IsVisible=false also takes the buttons out of hit testing, so a
         pointer-down on the row body cannot land on an invisible Reply. The render test asserts exactly that
         (IsEffectivelyVisible plus a hit test at the button's own centre, before and after a MouseMove). -->
    <Style Selector="views|NoteRowView:pointerover Border#CommandBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="views|NoteRowView:pointerover TextBlock#ShortTime">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|NoteRowView:pointerover TextBlock#LongTime">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Size/margin match the fork's fav/RT buttons — 32x22, widened to 46x22 for the ones that carry a
         word rather than a glyph (Timeline.xaml:1296-1298). CommandBar itself is left to size from its
         content rather than forced to the fork's Height=21: at 22px tall these buttons would clip inside
         a 21px container, and nothing in the brief asks the bar to be shorter than what it holds. -->
    <Style Selector="views|NoteRowView Button.row-command">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,-2" />
    </Style>
    <Style Selector="views|NoteRowView Button.row-command-icon">
      <Setter Property="Width" Value="32" />
    </Style>
  </UserControl.Styles>

  <!-- Background="Transparent" on the row root, not on the pieces inside it: without it the empty parts of
       the row (the avatar gutter while it has no image, the space past a short line of text) are not hit-tested,
       the pointer falls through to the ListBoxItem above, and :pointerover never fires there. The commands
       would then appear only while the pointer is literally over a glyph. The gutter-hover assertion in
       NoteRowShapeRenderTests is what holds this line in place. -->
  <!-- Margin matches the fork's own row Grid (StarryEyes/Views/WindowParts/Primitives/Timeline.xaml:830-832). -->
  <Grid ColumnDefinitions="Auto,*" Margin="8,10,0,10" Background="Transparent">
    <!-- Width and height match the fork's DecodePixelWidth="48" status avatar (Timeline.xaml:413). The size is
         fixed on the Border, not derived from the image: a row's height must be the same with an avatar, with
         none, and with one that failed to decode, or the column reflows as images arrive (L6b). The Image's
         Source is set from code-behind (NoteRowView.axaml.cs), not bound, because the bitmap arrives from a
         background fetch that has to be cancelled when the row is recycled; nothing is drawn until it does;
         a placeholder would claim "loading" for a URL the loader may never be asked about. -->
    <Border x:Name="AvatarSlot" Grid.Column="0" Width="48" Height="48"
            Margin="0,0,8,0" VerticalAlignment="Top" CornerRadius="4" ClipToBounds="True">
      <Image x:Name="AvatarImage" Stretch="UniformToFill" />
    </Border>

    <Panel Grid.Column="1">
      <!-- No Spacing here: the name row and the body below each carry their own fork-measured margin
           (Timeline.xaml:1070-1075 / :1161-1183), and those already encode the gap between them. -->
      <StackPanel>
        <!-- Margin matches the fork's name-row DockPanel (Timeline.xaml:1070-1075). -->
        <DockPanel LastChildFill="True" Margin="0,-2,0,3">
          <!-- The timestamp is docked first so it keeps its width and the author label is the part that
               ellipsizes; docking it last would let a long name push the time out of the row. -->
          <Panel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0">
            <!-- FontSize/FontWeight match the fork's timestamp text (Timeline.xaml:1250-1285). -->
            <TextBlock x:Name="ShortTime" Text="{Binding TimeLabel}" Opacity="0.6"
                       FontSize="10.667" FontWeight="SemiLight" />
            <TextBlock x:Name="LongTime" Text="{Binding AbsoluteTimeLabel}" Opacity="0.6"
                       FontSize="10.667" FontWeight="SemiLight" />
          </Panel>
          <!-- FontSize matches the fork's screen-name text (Timeline.xaml:1076-1088). This label already
               combines the fork's screen name and display name into one string (AuthorLabel.cs) — Nostr has
               no separate handle/display-name pair the way the fork's Twitter-backed one did, and nothing
               downstream of a kind:0 profile produces a second string to put on a "display name" line of its
               own, so there is no second FontSize (12.667, Semilight) to apply here. -->
          <TextBlock x:Name="AuthorLabelText" Text="{Binding AuthorLabel}" FontWeight="SemiBold" FontSize="13.333"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <!-- Margin matches the fork's body Grid; no FontSize override there either, by design (Timeline.xaml:1161-1183). -->
        <TextBlock Text="{Binding DisplayContent}" TextWrapping="Wrap" Margin="10,3,2,0" />
      </StackPanel>

      <!-- Overlaid rather than stacked under the body: revealing it must not change the row's height, or
           every row below would jump as the pointer travels down the column. -->
      <Border x:Name="CommandBar"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              CornerRadius="4" Padding="2"
              Background="{DynamicResource KrilePanelBackgroundBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="ReplyButton" Classes="row-command" Content="Reply"
                  IsEnabled="{Binding CanReplyOrRepost}" Click="OnReplyClick" />
          <Button x:Name="RepostButton" Classes="row-command" Content="Repost"
                  IsEnabled="{Binding CanReplyOrRepost}" Click="OnRepostClick" />
          <Button x:Name="QuoteButton" Classes="row-command" Content="Quote" Click="OnQuoteClick" />
          <Button x:Name="ReactButton" Classes="row-command row-command-icon" Content="♥" Click="OnReactClick" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
