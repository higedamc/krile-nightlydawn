<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="using:NightlyDawn.App.Timelines"
        xmlns:views="using:NightlyDawn.App.Views"
        x:Class="NightlyDawn.App.MainWindow"
        x:DataType="tl:WorkspaceViewModel"
        Title="Krile NightlyDawn"
        Width="960" Height="640"
        MinWidth="480" MinHeight="320">
  <DockPanel Margin="16">
    <!-- The tab strip moved out of this header row and into each column (plan §21.2 / L4b): the PR #30
         placement put one workspace-wide strip here; the fork's structure gives every column its own.
         The title/subtitle row that used to sit above the compose box is gone (plan §26.5 / L4c ②): the
         screenshot has no heading, and the compose box is supposed to be the window's topmost row, not the
         second one. The window's own title bar (x:Class's Title property, below) still reads "Krile
         NightlyDawn" — that identity did not need an in-window copy. -->
    <DockPanel DockPanel.Dock="Top">
      <views:ThemeSwitcherView x:Name="ThemeSwitcher" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" />
      <views:ComposeBoxView x:Name="ComposeBox" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Opacity="0.5" FontSize="12" Margin="0,8,0,0"
               Text="Based on Krile StarryEyes by Karno (MIT). New code (C) 2026 Krile NightlyDawn contributors." />

    <!-- Status line (plan §26.5 / L4c ⑥): the selected column's selected tab's note count, a thin row just
         above the copyright line. FallbackValue covers the (SelectedColumn, SelectedTab) chain being briefly
         null (e.g. a column with zero tabs); WindowChromeRenderTests asserts both the fallback text and the
         real count after Subscribe, the same before/after shape TabHeaderRenderTests used for plan §24.2's
         bug — a FallbackValue alone would otherwise mask a binding that never updates. -->
    <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Opacity="0.6" FontSize="11" Margin="0,4,0,0"
               Text="{Binding SelectedColumn.SelectedTab.Notes.Count, FallbackValue='0 notes', StringFormat='{}{0} notes'}" />

    <views:KeysPanelView x:Name="KeysPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0" />

    <!-- Omarchy / Wayland spike panel from the app shell (#3); collapsed now that the column is the main content. -->
    <Expander DockPanel.Dock="Bottom" Margin="0,12,0,0" IsExpanded="False"
              Header="Platform check (Omarchy / Wayland spike)">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock x:Name="PlatformInfo" FontFamily="monospace" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="ClipboardProbe" Width="320" PlaceholderText="Type here (IME check), then copy / paste" />
          <Button Content="Copy" Click="OnCopyClick" />
          <Button Content="Paste" Click="OnPasteClick" />
        </StackPanel>
        <TextBlock x:Name="ClipboardStatus" Opacity="0.7" />
      </StackPanel>
    </Expander>

    <views:WorkspaceView x:Name="Workspace" Margin="0,16,0,0" />
  </DockPanel>
</Window>
