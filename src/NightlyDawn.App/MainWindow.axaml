<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="using:NightlyDawn.App.Timelines"
        xmlns:views="using:NightlyDawn.App.Views"
        x:Class="NightlyDawn.App.MainWindow"
        x:DataType="tl:TimelineColumnViewModel"
        Title="Krile NightlyDawn"
        Width="960" Height="640"
        MinWidth="480" MinHeight="320">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Text="Krile NightlyDawn" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Type a query, press Subscribe, and notes stream into the column below."
                 Opacity="0.7" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Opacity="0.5" FontSize="12" Margin="0,8,0,0"
               Text="Based on Krile StarryEyes by Karno (MIT). New code (C) 2026 Krile NightlyDawn contributors." />

    <views:ComposeBoxView x:Name="ComposeBox" DockPanel.Dock="Top" Margin="0,12,0,0" />

    <!-- Keys (goal ②'s UI half). Collapsed: the timeline never needs a key, so this panel is optional for ③. -->
    <Expander x:Name="KeysExpander" DockPanel.Dock="Bottom" Margin="0,12,0,0" IsExpanded="False" Header="Keys">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Opacity="0.8" />

        <!-- No key: generate -->
        <StackPanel x:Name="GenerateBox" Spacing="6">
          <TextBlock Text="This passphrase is the only thing protecting the key. NIP-49 recommends never publishing an ncryptsec: a weak passphrase can be brute-forced (about 100 ms per guess at the default cost)."
                     TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="GeneratePassphrase" Width="240" PasswordChar="●" PlaceholderText="Passphrase" />
            <TextBox x:Name="GenerateConfirm" Width="240" PasswordChar="●" PlaceholderText="Repeat passphrase" />
            <Button Content="Generate key" Click="OnGenerateKeyClick" />
          </StackPanel>
        </StackPanel>

        <!-- Stored but locked: unlock -->
        <StackPanel x:Name="UnlockBox" Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="UnlockPassphrase" Width="240" PasswordChar="●" PlaceholderText="Passphrase" />
          <Button Content="Unlock" Click="OnUnlockClick" />
        </StackPanel>

        <!-- Unlocked -->
        <StackPanel x:Name="UnlockedBox" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Public key:" Opacity="0.7" />
            <TextBlock x:Name="NpubText" FontFamily="monospace" />
            <Button Content="Copy npub" Click="OnCopyNpubClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="hex:" Opacity="0.5" FontSize="12" />
            <TextBlock x:Name="PubkeyText" FontFamily="monospace" Opacity="0.5" FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ExportPassphrase" Width="240" PasswordChar="●" PlaceholderText="Passphrase for the export" />
            <Button Content="Export (ncryptsec)" Click="OnExportClick" />
            <Button Content="Lock" Click="OnLockClick" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SignOutButton" Content="Sign out (deletes the stored key from this device)" Click="OnSignOutClick" />
            <Button x:Name="CancelSignOutButton" Content="Cancel" Click="OnCancelSignOutClick" IsVisible="False" />
          </StackPanel>
          <StackPanel x:Name="ExportBox" Spacing="6">
            <TextBlock Text="This is the encrypted form (ncryptsec); it needs your passphrase to use. Copying puts it on the system clipboard, which other apps on this account and Universal Clipboard can read. Nothing is copied until you press Copy."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="ExportedKey" Width="520" IsReadOnly="True" FontFamily="monospace" />
              <Button Content="Copy" Click="OnCopyExportClick" />
              <Button Content="Clear" Click="OnClearExportClick" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Expander>

    <!-- Omarchy / Wayland spike panel from the app shell (#3); collapsed now that the column is the main content. -->
    <Expander DockPanel.Dock="Bottom" Margin="0,12,0,0" IsExpanded="False"
              Header="Platform check (Omarchy / Wayland spike)">
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <TextBlock x:Name="PlatformInfo" FontFamily="monospace" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="ClipboardProbe" Width="320" PlaceholderText="Type here (IME check), then copy / paste" />
          <Button Content="Copy" Click="OnCopyClick" />
          <Button Content="Paste" Click="OnPasteClick" />
        </StackPanel>
        <TextBlock x:Name="ClipboardStatus" Opacity="0.7" />
      </StackPanel>
    </Expander>

    <!-- The one timeline column (1e). Query text goes to the ITimelineSourceFactory verbatim; KQL is compiled downstream (1c). -->
    <Border Margin="0,16,0,0" Padding="12"
            BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            CornerRadius="6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="QueryBox" Width="520"
                   Text="{Binding Query, Mode=TwoWay}"
                   PlaceholderText="from home   |   from user(npub1...)   |   from search(&quot;nostr&quot;)" />
          <Button x:Name="SubscribeButton" Content="Subscribe" IsDefault="True" Click="OnSubscribeClick" />
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" Margin="0,8,0,0" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" />

        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,4" Opacity="0.7"
                   Text="{Binding Status}" />

        <ListBox x:Name="TimelineList" ItemsSource="{Binding Notes}" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tl:NoteRow">
              <views:NoteRowView />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
