<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tl="using:NightlyDawn.App.Timelines"
        xmlns:views="using:NightlyDawn.App.Views"
        x:Class="NightlyDawn.App.MainWindow"
        x:DataType="tl:WorkspaceViewModel"
        Title="Krile NightlyDawn"
        Width="960" Height="640"
        MinWidth="480" MinHeight="320">
  <DockPanel Margin="16">
    <!-- The tab strip moved out of this header row and into each column (plan §21.2 / L4b): the PR #30
         placement put one workspace-wide strip here; the fork's structure gives every column its own.
         The title/subtitle row that used to sit above the compose box is gone (plan §26.5 / L4c ②): the
         screenshot has no heading, and the compose box is supposed to be the window's topmost row, not the
         second one. The window's own title bar (x:Class's Title property, below) still reads "Krile
         NightlyDawn" — that identity did not need an in-window copy. -->
    <DockPanel DockPanel.Dock="Top">
      <views:ThemeSwitcherView x:Name="ThemeSwitcher" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" />
      <!-- The search box (L7a, plan §37): the fork keeps it in the window header (StarryEyes MainWindow.xaml:110),
           so it shares the compose row here, docked left of the theme switch, which stays the rightmost item.
           Focusing it opens SearchFlip below, over the workspace. -->
      <views:SearchBoxView x:Name="SearchBoxHost" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" />
      <views:ComposeBoxView x:Name="ComposeBox" />
    </DockPanel>

    <!-- One bottom band (L20): the fork's window has a single Auto-height row under its content,
         `Grid Name="StatusGrid" Grid.Row="1" Background="Transparent"` (StarryEyes MainWindow.xaml:315-322), with
         its cells side by side. This port used to stack two text rows here (copyright, then status line); they
         are now two cells of one row. Only cells with a real state behind them exist: the fork's mute toggle,
         tweet counters, uptime and Backstage click have nothing to show in this port, so none is drawn and the
         band does not react to clicks (there is nothing to open).
         Status line (plan §26.5 / L4c ⑥): the selected column's selected tab's note count. FallbackValue covers
         the (SelectedColumn, SelectedTab) chain being briefly null (e.g. a column with zero tabs);
         WindowChromeRenderTests.StatusLine_ChangesFromTheFallbackToARealCountAfterSubscribing asserts both the
         fallback text and the real count after Subscribe - a FallbackValue alone would otherwise mask a binding
         that never updates. It keeps x:Name="StatusLine" (tests look it up by name).
         The MIT attribution stays as the second cell even though the fork has no such cell: the licence notice
         outranks visual parity. It wraps rather than trims, so it is never cut at narrow widths;
         StatusBandRenderTests pins that it shares one row with the status line at the sizes the render suite
         covers. -->
    <Grid x:Name="StatusBand" DockPanel.Dock="Bottom" Background="Transparent" Margin="0,8,0,0"
          ColumnDefinitions="Auto,*">
      <TextBlock x:Name="StatusLine" Grid.Column="0" Opacity="0.6" FontSize="11" VerticalAlignment="Center"
                 Margin="0,0,16,0"
                 Text="{Binding SelectedColumn.SelectedTab.Notes.Count, FallbackValue='0 notes', StringFormat='{}{0} notes'}" />
      <TextBlock x:Name="Copyright" Grid.Column="1" Opacity="0.5" FontSize="12" VerticalAlignment="Center"
                 TextAlignment="Right" TextWrapping="Wrap"
                 Text="Based on Krile StarryEyes by Karno (MIT). New code (C) 2026 Krile NightlyDawn contributors." />
    </Grid>

    <views:KeysPanelView x:Name="KeysPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0" />

    <!-- Workspace and the search flip share one Panel so the flip is literally over the workspace (the fork's
         flip covers its main area, SearchFlip.xaml:263): same slot, same margin, the columns keep streaming
         underneath while it is open. SearchFlipView is collapsed (IsVisible=false) whenever the flip is closed. -->
    <Panel Margin="0,16,0,0">
      <views:WorkspaceView x:Name="Workspace" />
      <views:SearchFlipView x:Name="SearchFlip" />
    </Panel>
  </DockPanel>
</Window>
